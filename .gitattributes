# Normalise text files to LF in the repository
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.bin  binary
*.woff binary
*.woff2 binary

# The executed notebook is stored verbatim (outputs included); do not diff or rewrite it
*.ipynb -text -diff

# Committed TF.js model weights and topology are generated
web/public/model/** linguist-generated=true
